#!/bin/bash
#SBATCH --partition=gpu_a100
#SBATCH --gpus=1
#SBATCH --job-name=compute-metrics
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=18
#SBATCH --time=01:00:00
#SBATCH --output=slurm/logs/metrics_%j.out
#SBATCH --error=slurm/logs/metrics_%j.err

echo "=== Computing metrics from saved activations ==="

module purge

cd "$HOME/Tracing-representation-geometry-reproduction" || exit 1

DATASET="fineweb"

MODELS=(
    "pythia-14m"
    "pythia-14m-deduped"
    "pythia-31m"
    "pythia-31m-deduped"
    "pythia-70m"
    "pythia-70m-deduped"
    "pythia-160m"
    "pythia-160m-deduped"
    "pythia-410m"
    "pythia-410m-deduped"
    "pythia-1b"
    "pythia-1b-deduped"
    "pythia-1.4b"
    "pythia-1.4b-deduped"
    "pythia-2.8b"
    "pythia-2.8b-deduped"
    "pythia-6.9b"
    "pythia-6.9b-deduped"
    "pythia-12b"
    "pythia-12b-deduped"
    "OLMo-2-0425-1B"
    "OLMo-2-1124-7B"
)

export OMP_NUM_THREADS=1
for MODEL in "${MODELS[@]}"; do
    if [ -d "activations/${DATASET}/${MODEL}" ]; then
        echo "--- ${MODEL} ---"
        time uv run rankme_alpha_scripts/compute_metrics.py \
            --dataset_name "${DATASET}" \
            --num_workers "${SLURM_CPUS_PER_TASK}" \
            "${MODEL}"
    fi
done

echo "=== Done ==="
