#!/bin/bash
# Two offline analyses of the final stream against the unembedding.
#
#   stream_deflation    which subspace of W_U carries the compression phase, plus whether the
#                       stream's dominant direction is dark in the first place
#   alpha_conservation  the stream / head / word-score spectra behind the alphaReQ mirroring
#
# NEITHER DOWNLOADS ANYTHING. Both read the stored final_stream_svd covariances and the stored
# head SVDs (unembedding_svd + unembedding_spectra.pt). An earlier version recomputed the head
# from weights per checkpoint, which pulled a full model snapshot each time and put 248 GB of
# pythia-1b into the cache to reproduce a matrix already on disk. A checkpoint with no stored
# head SVD is now skipped with a reason, never fetched.
#
# GPU because both are eigendecomposition-heavy (one d x d eigh per variant per checkpoint).
#SBATCH --partition=gpu_h100
#SBATCH --gpus=1
#SBATCH --job-name=unemb_routes
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=16
#SBATCH --time=04:00:00
#SBATCH --output=slurm/logs/unemb_routes_%j.out

set -euo pipefail
cd "$SLURM_SUBMIT_DIR" || exit 1
export HF_HOME="/projects/prjs1815/hf_cache"

echo "=== stream_deflation ==="
time uv run oneoff_scripts/stream_deflation.py

echo "=== alpha_conservation (log-spaced grid) ==="
time uv run oneoff_scripts/alpha_conservation.py

echo "=== COVERAGE SUMMARY ==="
grep -h "^COVERAGE" "$0.$SLURM_JOB_ID.out" 2>/dev/null || true
