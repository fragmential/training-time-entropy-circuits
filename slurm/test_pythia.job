#!/bin/bash
#SBATCH --partition=gpu_h100
#SBATCH --gpus=1
#SBATCH --job-name=test-pythia
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=16
#SBATCH --time=00:30:00
#SBATCH --output=slurm/logs/test_pythia_%j.out
#SBATCH --error=slurm/logs/test_pythia_%j.err

MODEL_NAME="EleutherAI/pythia-14m"
echo "=== Test run: ${MODEL_NAME} ==="

module purge

export HF_HOME="/projects/prjs1815/hf_cache"
cd /projects/prjs1815/representation-geometry || exit 1

uv run rankme_alpha_scripts/compute_alpha_pythia.py \
    --model_name "${MODEL_NAME}" \
    --num_samples 100 \
    --batch_size 64

echo "=== Done: ${MODEL_NAME} ==="
