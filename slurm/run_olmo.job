#!/bin/bash
#SBATCH --partition=gpu_h100
#SBATCH --gpus=1
#SBATCH --job-name=olmo-metrics
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=16
#SBATCH --time=04:00:00
#SBATCH --output=slurm/logs/olmo_%A_%a.out
#SBATCH --error=slurm/logs/olmo_%A_%a.err
#SBATCH --array=0-1

MODELS=(
    "allenai/OLMo-2-0425-1B"
    "allenai/OLMo-2-1124-7B"
)

BATCH_SIZES=(512 200)

MODEL_NAME="${MODELS[$SLURM_ARRAY_TASK_ID]}"
BATCH_SIZE="${BATCH_SIZES[$SLURM_ARRAY_TASK_ID]}"
echo "=== Running model: ${MODEL_NAME} (array task ${SLURM_ARRAY_TASK_ID}, batch_size ${BATCH_SIZE}) ==="

module purge

export HF_HOME="/projects/prjs1815/hf_cache"
cd "$HOME/Tracing-representation-geometry-reproduction" || exit 1

time uv run rankme_alpha_scripts/extract_activations.py \
    --model_name "${MODEL_NAME}" \
    --dataset_name "fineweb" \
    --num_samples 5000 \
    --max_length 512 \
    --batch_size "${BATCH_SIZE}"

echo "=== Done: ${MODEL_NAME} ==="
