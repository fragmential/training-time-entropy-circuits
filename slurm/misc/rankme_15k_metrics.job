#!/bin/bash
#SBATCH --job-name=rankme_15k_metrics
#SBATCH --partition=gpu_a100
#SBATCH --gpus=1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=18
#SBATCH --time=00:05:00
#SBATCH --output=slurm/logs/rankme_15k_metrics_%j.out

cd ~/Tracing-representation-geometry-reproduction

uv run python -c "
import sys; sys.path.insert(0, '.')
from utils.accessor import DataAccessor
from scripts.compute_metrics import spectral_metrics
import torch, numpy as np

ref_5k = {9000: 498.1, 12000: 529.3, 15000: 498.0}

print(f\"{'Step':>8}  {'5k ref':>8}  {'15k centered':>14}  {'15k manual':>12}  {'n':>6}\")
for step in [9000, 12000, 15000]:
    acc = DataAccessor(f'inferences/rankme_fineweb_15k_test/pythia-1b-deduped/step{step}.pt')
    ev_c = acc.after_final_norm.A.eigvals_centered
    m = spectral_metrics(ev_c)

    # Manual check
    X = acc.after_final_norm.A.acts.float()
    mu = X.mean(0)
    X_c = X - mu
    cov = (X_c.T @ X_c) / X_c.shape[0]
    ev_manual = torch.linalg.eigvalsh(cov).flip(0).clamp(min=0).double().numpy()
    p = ev_manual / ev_manual.sum()
    eps = 1e-10
    rm_manual = float(np.exp(-np.sum(p * np.log(np.clip(p, eps, None)))))

    ref = ref_5k.get(step, float('nan'))
    print(f'{step:8d}  {ref:>8.1f}  {m[\"rankme\"]:>14.1f}  {rm_manual:>12.1f}  {X.shape[0]:6d}')
"
