#!/bin/bash
#SBATCH --partition=gpu_h100
#SBATCH --gpus=1
#SBATCH --job-name=kfac-pythia
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=16
#SBATCH --time=12:00:00
#SBATCH --output=slurm/logs/kfac_pythia_%A_%a.out
#SBATCH --error=slurm/logs/kfac_pythia_%A_%a.err
#SBATCH --array=0-19

MODELS=(
    "EleutherAI/pythia-14m"
    "EleutherAI/pythia-14m-deduped"
    "EleutherAI/pythia-31m"
    "EleutherAI/pythia-31m-deduped"
    "EleutherAI/pythia-70m"
    "EleutherAI/pythia-70m-deduped"
    "EleutherAI/pythia-160m"
    "EleutherAI/pythia-160m-deduped"
    "EleutherAI/pythia-410m"
    "EleutherAI/pythia-410m-deduped"
    "EleutherAI/pythia-1b"
    "EleutherAI/pythia-1b-deduped"
    "EleutherAI/pythia-1.4b"
    "EleutherAI/pythia-1.4b-deduped"
    "EleutherAI/pythia-2.8b"
    "EleutherAI/pythia-2.8b-deduped"
    "EleutherAI/pythia-6.9b"
    "EleutherAI/pythia-6.9b-deduped"
    "EleutherAI/pythia-12b"
    "EleutherAI/pythia-12b-deduped"
)

MODEL_NAME="${MODELS[$SLURM_ARRAY_TASK_ID]}"

# K-FAC needs backward pass → much smaller batch sizes than activation collection
if [[ "${MODEL_NAME}" == *"12b"* ]]; then
    BATCH_SIZE=8
elif [[ "${MODEL_NAME}" == *"6.9b"* ]]; then
    BATCH_SIZE=16
elif [[ "${MODEL_NAME}" == *"2.8b"* ]]; then
    BATCH_SIZE=32
elif [[ "${MODEL_NAME}" == *"1.4b"* ]] || [[ "${MODEL_NAME}" == *"1b"* ]]; then
    BATCH_SIZE=64
elif [[ "${MODEL_NAME}" == *"410m"* ]]; then
    BATCH_SIZE=128
else
    BATCH_SIZE=256
fi

echo "=== K-FAC collection: ${MODEL_NAME} (array task ${SLURM_ARRAY_TASK_ID}, batch_size ${BATCH_SIZE}) ==="

module purge

export HF_HOME="/projects/prjs1815/hf_cache"
cd "$HOME/Tracing-representation-geometry-reproduction" || exit 1

time uv run kfac_scripts/collect_kfac.py \
    --model_name "${MODEL_NAME}" \
    --dataset_name "fineweb" \
    --num_samples 5000 \
    --seq_len 512 \
    --batch_size "${BATCH_SIZE}" \
    --layers_per_pass 4 \
    --sample_labels true \
    --max_checkpoints 30

echo "=== Done: ${MODEL_NAME} ==="
